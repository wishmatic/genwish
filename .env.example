# genwish environment. Copy to .env and adjust.

# API keys are stored by `genwish login <provider>`, not here.

# Input address rewrites, comma-separated public=private pairs.
IMAGE_URL_MAP=

# Default image format for Forge Neo and NovelAI: png, jpeg, jxl, or webp.
OUTPUT_FORMAT=webp

# Forge Neo API base URL.
SD_URL=http://127.0.0.1:7860

# Newline-delimited checkpoint names for `genwish models list neo`.
NEO_MODELS_FILE=

# Credential backend: auto, keyring, or file.
GENWISH_CREDENTIAL_BACKEND=auto

# Danbooru settings for `genwish util booru`.
ERROR_DETAIL=useful
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=1
REQUEST_TIMEOUT_SECONDS=20
MAX_LIMIT=100
MAX_OFFSET=1000
BLOCKED_TAGS=

# Reserved for internal logging.
LOG_LEVEL=info
